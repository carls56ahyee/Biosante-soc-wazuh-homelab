<!-- Blocs FIM et SCA à intégrer dans /var/ossec/etc/ossec.conf sur biosanteweb -->
<ossec_config>
  <syscheck>
    <disabled>no</disabled>
    <frequency>43200</frequency>
    <directories realtime="yes" report_changes="yes" check_all="yes">/var/www/html</directories>
    <!-- En production avec auditd installé, remplacer realtime="yes" par whodata="yes" -->
    <ignore>/var/www/html/tmp/</ignore>
  </syscheck>

  <sca>
    <enabled>yes</enabled>
    <scan_on_start>yes</scan_on_start>
    <interval>12h</interval>
    <skip_nfs>yes</skip_nfs>
  </sca>
</ossec_config>
